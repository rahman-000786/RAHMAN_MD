<body>
  <main class="wrap">
    <header class="topbar">
      <div class="brand-mini">
        <div class="brand-mark" aria-hidden="true">R</div>
        <span id="miniBrand"></span>
      </div>
      <div class="status" id="serverStatus"><span class="dot"></span><span id="statusText">Checking server</span></div>
    </header>

    <section class="hero">
      <div class="banner-shell"><img class="banner" id="brandBanner" alt="Brand logo"></div>
      <div class="eyebrow">WhatsApp connection portal</div>
      <h1 id="brandTitle"></h1>
      <p class="subtitle">Connect your WhatsApp account in seconds. Generate your secure pairing code and link your device.</p>
      <div class="owner-line">Managed by <strong id="ownerName"></strong></div>
      <a class="channel-link" id="channelLink" target="_blank" rel="noopener noreferrer">
        <span aria-hidden="true">◉</span> Join WhatsApp Channel <span aria-hidden="true">↗</span>
      </a>
    </section>

    <section class="stats" aria-label="Live server statistics">
      <div class="stat"><div class="stat-label">Total users</div><div class="stat-value" id="totalUsers">—</div><div class="stat-foot">Across the server</div></div>
      <div class="stat"><div class="stat-label">Connected sessions</div><div class="stat-value" id="activeSessions">—</div><div class="stat-foot">Currently connected</div></div>
      <div class="stat"><div class="stat-label">New today</div><div class="stat-value" id="dailyNew">—</div><div class="stat-foot">Daily activity</div></div>
      <div class="stat"><div class="stat-label">Total paired</div><div class="stat-value" id="totalPaired">—</div><div class="stat-foot">Successful pairings</div></div>
    </section>

    <section class="main-grid">
      <div class="card pair-card">
        <div class="card-heading">
          <h2>Pair your device</h2>
          <span class="step-pill">01 / CONNECT</span>
        </div>
        <p class="card-copy">Enter your WhatsApp number with its country code to receive a pairing code.</p>
        <form id="pairForm" novalidate>
          <label for="countryCode">Phone number</label>
          <div class="phone-row">
            <div class="country-wrap"><input class="field country" id="countryCode" type="tel" inputmode="numeric" value="92" aria-label="Country calling code" autocomplete="tel-country-code"></div>
            <input class="field" id="phoneNumber" type="tel" inputmode="numeric" placeholder="Your phone number" autocomplete="tel-national" aria-label="Phone number" required>
          </div>
          <p class="input-note">Include your country calling code. Do not enter a leading plus sign in the number field.</p>
          <button class="primary-btn" id="pairButton" type="submit">Get Pairing Code <span aria-hidden="true">→</span></button>
        </form>
        <div class="result" id="pairResult" aria-live="polite">
          <div class="result-label">Your pairing code</div>
          <div class="code" id="pairCode">••••-••••</div>
          <div class="result-bottom">
            <span class="timer" id="countdown">Expires in 02:00</span>
            <button class="copy-btn" id="copyButton" type="button">Copy code</button>
          </div>
        </div>
      </div>

      <aside class="card how-card">
        <h2>How to connect</h2>
        <div class="instruction"><div class="instruction-num">1</div><div><strong>Enter your number</strong><p>Choose your country code and type the WhatsApp number you want to connect.</p></div></div>
        <div class="instruction"><div class="instruction-num">2</div><div><strong>Generate your code</strong><p>Tap the button and wait a moment while your pairing code is created.</p></div></div>
        <div class="instruction"><div class="instruction-num">3</div><div><strong>Link on WhatsApp</strong><p>Open WhatsApp → Linked devices → Link a device → Link with phone number instead.</p></div></div>
        <div class="tip"><strong>Keep this page open.</strong> Enter the displayed code on your phone before the countdown reaches zero.</div>
      </aside>
    </section>

    <footer class="footer">
      <span id="footerBrand"></span>
      <span>Secure device pairing · Live server status</span>
    </footer>
  </main>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script>
    const $ = (id) => document.getElementById(id);
    const api = CONFIG.backendUrl.replace(/\/+$/, "");
    let toastTimeout;
    let countdownInterval;
    let remainingSeconds = 0;
    let currentCode = "";

    function applyBrand() {
      document.title = CONFIG.brandName + " | Pairing Dashboard";
      $("miniBrand").textContent = CONFIG.brandName;
      $("brandTitle").textContent = CONFIG.brandName;
      $("brandBanner").src = CONFIG.bannerImageUrl;
      $("ownerName").textContent = CONFIG.ownerName;
      $("channelLink").href = CONFIG.channelLink;
      $("footerBrand").textContent = "© " + new Date().getFullYear() + " " + CONFIG.brandName;
      $("brandBanner").addEventListener("error", () => {
        $("brandBanner").style.visibility = "hidden";
      }, { once: true });
    }

    function showToast(message, isError = false) {
      const toast = $("toast");
      toast.textContent = message;
      toast.classList.toggle("error", isError);
      toast.classList.add("show");
      clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => toast.classList.remove("show"), 3800);
    }

    async function apiFetch(path, options = {}) {
      return fetch(api + path, {
        ...options,
        headers: { "Content-Type": "application/json", ...(options.headers || {}) }
      });
    }

    async function checkHealth() {
      try {
        const response = await apiFetch("/api/health");
        if (!response.ok) throw new Error("Server unavailable");
        const data = await response.json();
        if (data.status !== "ok") throw new Error("Server unavailable");
        $("serverStatus").classList.add("online");
        $("statusText").textContent = "Server online";
      } catch (_) {
        $("serverStatus").classList.remove("online");
        $("statusText").textContent = "Server offline";
      }
    }

    async function loadStats() {
      try {
        const response = await apiFetch("/api/stats");
        if (!response.ok) return;
        const data = await response.json();
        if (!data.ok) return;
        $("totalUsers").textContent = Number(data.totalUsers ?? 0).toLocaleString();
        $("activeSessions").textContent = Number(data.activeSessions ?? 0).toLocaleString();
        $("dailyNew").textContent = Number(data.dailyNew ?? 0).toLocaleString();
        $("totalPaired").textContent = Number(data.totalPaired ?? 0).toLocaleString();
      } catch (_) {
        // Keep the last successfully displayed values.
      }
    }

    function formatCode(code) {
      const clean = String(code || "").replace(/[^a-z0-9]/gi, "").toUpperCase();
      return clean.length === 8 ? clean.slice(0, 4) + "-" + clean.slice(4) : clean;
    }

    function renderCountdown() {
      const mins = Math.floor(remainingSeconds / 60).toString().padStart(2, "0");
      const secs = (remainingSeconds % 60).toString().padStart(2, "0");
      $("countdown").textContent = remainingSeconds > 0 ? `Expires in ${mins}:${secs}` : "Code expired";
      if (remainingSeconds <= 0) {
        clearInterval(countdownInterval);
        $("pairCode").textContent = currentCode ? formatCode(currentCode) : "—";
        $("copyButton").disabled = true;
      }
    }

    function startCountdown(seconds) {
      clearInterval(countdownInterval);
      remainingSeconds = Math.max(0, Math.floor(Number(seconds) || 0));
      $("copyButton").disabled = remainingSeconds <= 0;
      $("pairResult").classList.add("show");
      renderCountdown();
      countdownInterval = setInterval(() => {
        remainingSeconds = Math.max(0, remainingSeconds - 1);
        renderCountdown();
      }, 1000);
    }

    function setLoading(loading) {
      const button = $("pairButton");
      button.disabled = loading;
      button.textContent = loading ? "Generating..." : "Get Pairing Code →";
    }

    $("pairForm").addEventListener("submit", async (event) => {
      event.preventDefault();
      const country = $("countryCode").value.replace(/\D/g, "");
      const local = $("phoneNumber").value.replace(/\D/g, "");
      const number = (country + local).replace(/\D/g, "");

      if (!country || !local || number.length < 10 || number.length > 15) {
        showToast("Enter a valid phone number between 10 and 15 digits, including the country code.", true);
        return;
      }

      setLoading(true);
      $("pairResult").classList.remove("show");
      try {
        const response = await apiFetch("/api/pair", {
          method: "POST",
          body: JSON.stringify({
            number,
            brand: {
              name: CONFIG.brandName,
              banner: CONFIG.bannerImageUrl,
              owner: CONFIG.ownerNumber,
              ownerName: CONFIG.ownerName,
              channel: CONFIG.channelLink
            }
          })
        });

        let data = {};
        try { data = await response.json(); } catch (_) {}
        if (!response.ok) {
          const messages = {
            400: data.error || "Invalid phone number. Check the number and try again.",
            429: data.error || "A pairing is already in progress. Please wait a moment.",
            503: data.error || "Pairing capacity is full. Please try again later.",
            500: data.error || "Could not generate a pairing code. Please try again."
          };
          throw new Error(messages[response.status] || data.error || "Could not generate a pairing code.");
        }
        if (!data.code) throw new Error(data.error || "The server did not return a pairing code.");

        currentCode = String(data.code);
        $("pairCode").textContent = formatCode(currentCode);
        startCountdown(data.expiresIn ?? 120);
        showToast("Pairing code generated. Enter it in WhatsApp Linked devices.");
      } catch (error) {
        const message = error instanceof TypeError
          ? "Could not reach server, please try again."
          : (error.message || "Could not reach server, please try again.");
        showToast(message, true);
      } finally {
        setLoading(false);
      }
    });

    $("copyButton").addEventListener("click", async () => {
      if (!currentCode || remainingSeconds <= 0) return;
      try {
        await navigator.clipboard.writeText(currentCode);
        showToast("Pairing code copied.");
      } catch (_) {
        const textArea = document.createElement("textarea");
        textArea.value = currentCode;
        textArea.style.position = "fixed";
        textArea.style.opacity = "0";
        document.body.appendChild(textArea);
        textArea.select();
        try {
          document.execCommand("copy");
          showToast("Pairing code copied.");
        } catch (_) {
          showToast("Could not copy automatically. Select the code to copy it.", true);
        }
        textArea.remove();
      }
    });

    applyBrand();
    checkHealth();
    loadStats();
    setInterval(loadStats, 30000);
    setInterval(checkHealth, 30000);
  </script>
</body>
